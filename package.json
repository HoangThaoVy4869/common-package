      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "moleculer": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^9.3.4",
    "@nestjs/common": "^11.1.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.10.0",
    "moleculer": "^0.14.35",
    "mongoose": "^9.3.1",
    "typescript": "^5.9.3"
  }
}