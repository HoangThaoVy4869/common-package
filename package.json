{
    "name": "@vyhoang/microservice-clean",
    "version": "1.2.2",
    "description": "Shared TypeScript utilities and infrastructure helpers for backend services.",
    "exports": {
        "./core": {
            "types": "./dist/core/index.d.ts",
            "require": "./dist/core/index.js",
            "default": "./dist/core/index.js"
        },
        "./infrastructure": {
            "types": "./dist/infrastructure/index.d.ts",
            "require": "./dist/infrastructure/index.js",
            "default": "./dist/infrastructure/index.js"
        },
        "./infrastructure/cache": {
            "types": "./dist/infrastructure/cache/index.d.ts",
            "require": "./dist/infrastructure/cache/index.js",
            "default": "./dist/infrastructure/cache/index.js"
        },
        "./infrastructure/idempotency": {
            "types": "./dist/infrastructure/idempotency/index.d.ts",
            "require": "./dist/infrastructure/idempotency/index.js",
            "default": "./dist/infrastructure/idempotency/index.js"
        },
        "./infrastructure/languages": {
            "types": "./dist/infrastructure/languages/index.d.ts",
            "require": "./dist/infrastructure/languages/index.js",
            "default": "./dist/infrastructure/languages/index.js"
        },
        "./infrastructure/validation": {
            "types": "./dist/infrastructure/validation/index.d.ts",
            "require": "./dist/infrastructure/validation/index.js",
            "default": "./dist/infrastructure/validation/index.js"
        },
        "./infrastructure/queue": {
            "types": "./dist/infrastructure/queue/index.d.ts",
            "require": "./dist/infrastructure/queue/index.js",
            "default": "./dist/infrastructure/queue/index.js"
        },
        "./infrastructure/repositories": {
            "types": "./dist/infrastructure/repositories/index.d.ts",
            "require": "./dist/infrastructure/repositories/index.js",
            "default": "./dist/infrastructure/repositories/index.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "core": [
                "dist/core/index.d.ts"
            ],
            "infrastructure": [
                "dist/infrastructure/index.d.ts"
            ],
            "infrastructure/cache": [
                "dist/infrastructure/cache/index.d.ts"
            ],
            "infrastructure/idempotency": [
                "dist/infrastructure/idempotency/index.d.ts"
            ],
            "infrastructure/languages": [
                "dist/infrastructure/languages/index.d.ts"
            ],
            "infrastructure/validation": [
                "dist/infrastructure/validation/index.d.ts"
            ],
            "infrastructure/queue": [
                "dist/infrastructure/queue/index.d.ts"
            ],
            "infrastructure/repositories": [
                "dist/infrastructure/repositories/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.build.json --incremental false",
        "prepublishOnly": "npm run build",
        "test": "echo \"No tests configured\""
    },
    "keywords": [
        "typescript",
        "common",
        "shared",
        "utility",
        "infrastructure"
    ],
    "author": "VyHoang",
    "license": "ISC",
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HoangThaoVy4869/common-package.git"
    },
    "homepage": "https://github.com/HoangThaoVy4869/common-package#readme",
    "bugs": {
        "url": "https://github.com/HoangThaoVy4869/common-package/issues"
    },
    "dependencies": {
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^0.10.9",
        "lodash": "^4.17.21",
        "split2": "^4.2.0",
        "uuidv7": "^1.2.1"
    },
    "peerDependencies": {
        "@elastic/elasticsearch": "^9.3.4",
        "@grpc/grpc-js": "^1.14.4",
        "@nestjs/common": "^11.1.17",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "ioredis": "^5.10.0"
    },
    "peerDependenciesMeta": {
        "@grpc/grpc-js": {
            "optional": true
        },
        "@elastic/elasticsearch": {
            "optional": true
        },
        "@nestjs/common": {
            "optional": true
        },
        "class-transformer": {
            "optional": true
        },
        "class-validator": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@elastic/elasticsearch": "^9.3.4",
        "@grpc/grpc-js": "^1.14.4",
        "@nestjs/common": "^11.1.17",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "ioredis": "^5.10.0",
        "mongoose": "^9.3.1",
        "split2": "^4.2.0",
        "typescript": "^5.9.3"
    }
}