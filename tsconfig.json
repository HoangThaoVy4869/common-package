{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@core": [
        "src/core/index"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@infrastructure": [
        "src/infrastructure/index"
      ],
      "@infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@messaging": [
        "src/infrastructure/messaging/index"
      ],
      "@messaging/*": [
        "src/infrastructure/messaging/*"
      ],
      "@messaging-common": [
        "src/infrastructure/messaging/common/index"
      ],
      "@messaging-common/*": [
        "src/infrastructure/messaging/common/*"
      ],
      "@kafka": [
        "src/infrastructure/messaging/kafka/index"
      ],
      "@kafka/*": [
        "src/infrastructure/messaging/kafka/*"
      ],
      "@rabbitmq": [
        "src/infrastructure/messaging/rabbitmq/index"
      ],
      "@rabbitmq/*": [
        "src/infrastructure/messaging/rabbitmq/*"
      ]
    },
    "esModuleInterop": true,
    "isolatedModules": false,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}